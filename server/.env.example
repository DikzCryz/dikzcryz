# Isi hanya di Railway Variables atau file .env lokal yang TIDAK di-commit.
GEMINI_API_KEY=
# Pilih model yang benar-benar tersedia di Google AI Studio project milikmu.
GEMINI_CHAT_MODEL=gemini-3.1-flash-lite
# Fallback dipisahkan koma. Fallback memakai project/API key yang sama dan kuota model masing-masing.
GEMINI_FALLBACK_MODELS=gemini-3.8-flash

SUPABASE_URL=https://PROJECT.supabase.co
SUPABASE_ANON_KEY=

# Opsional; layanan VN tetap bisa aktif walau Gemini tidak tersedia.
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_TTS_MODEL=eleven_v3

PORT=8787
ALLOWED_ORIGINS=https://appassets.androidplatform.net
